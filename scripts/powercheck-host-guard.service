[Unit]
Description=PowerCheck local Linux host outage guard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/powercheck-hostguard -host manager-host -confirm-host manager-host -confirm-auto-guard "AUTO SHUTDOWN manager-host" -execute -state /var/lib/powercheck/host-guard-state.json -nut-address 192.0.2.20:3493 -lan-targets 192.0.2.1,192.0.2.20,192.0.2.30 -wan-targets 223.5.5.5,119.29.29.29 -interval 5 -confirm 30
Restart=on-failure
RestartSec=5
User=root
UMask=0077
LogNamespace=powercheck
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
