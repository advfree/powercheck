[Unit]
Description=PowerCheck local automatic outage guard
After=network-online.target pve-cluster.service nut-monitor.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/powercheck-pve -action guard -node pve -confirm-node pve -timeout 45 -execute -emergency -confirm-auto-guard "AUTO SHUTDOWN pve" -outage-config /etc/powercheck/outage-config.json -guard-state /var/lib/powercheck/guard-state.json -guard-event-file /var/lib/powercheck/guard-events.jsonl -guard-nut-target ups@192.168.1.200 -guard-lan-targets 192.168.1.1,192.168.1.200 -guard-wan-targets 223.5.5.5,119.29.29.29
Restart=on-failure
RestartSec=5
User=root
UMask=0077
LogNamespace=powercheck
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
