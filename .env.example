# Required: PVE API-only endpoint reachable from the Docker host.
POWERCHECK_PVE_URL=http://192.0.2.30:8765

# Optional Manager settings.
POWERCHECK_MANAGER_LISTEN=0.0.0.0:8765
POWERCHECK_NUT_ADDRESS=
POWERCHECK_NUT_UPS=
POWERCHECK_UPS_SPEC=
POWERCHECK_WOL_CONFIG=
POWERCHECK_HEALTH_URL=http://127.0.0.1:8765/
TZ=UTC

# To enable optional files, place sanitized local copies in docker/config and use:
# POWERCHECK_UPS_SPEC=/config/ups-spec.json
# POWERCHECK_WOL_CONFIG=/config/wol.json
