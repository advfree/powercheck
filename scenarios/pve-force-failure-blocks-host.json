{
  "name": "fake PVE force failure blocks host poweroff",
  "description": "Guest 正常关机和强停都失败时，安全护栏阻止执行 systemctl poweroff。",
  "duration_seconds": 250,
  "changes": [
    {
      "at_seconds": 0,
      "nut": "OB",
      "lan_reachable": true,
      "wan_reachable": true
    }
  ],
  "fake_pve": {
    "guests": [
      {
        "id": 100,
        "name": "stuck",
        "kind": "vm",
        "shutdown_order": 10,
        "graceful_result": "stuck",
        "emergency_force_result": "failure"
      }
    ]
  },
  "expected_actions": [
    {
      "at_seconds": 0,
      "kind": "outage_candidate_started"
    },
    {
      "at_seconds": 30,
      "kind": "graceful_shutdown"
    },
    {
      "at_seconds": 240,
      "kind": "emergency_stop_remaining"
    },
    {
      "at_seconds": 240,
      "kind": "host_poweroff_requested"
    }
  ],
  "expected_pve_events": [
    {
      "at_seconds": 30,
      "kind": "pvenode_stopall",
      "outcome": "success"
    },
    {
      "at_seconds": 30,
      "kind": "guest_shutdown_requested",
      "guest_id": 100,
      "method": "acpi",
      "outcome": "success"
    },
    {
      "at_seconds": 240,
      "kind": "guest_emergency_force",
      "guest_id": 100,
      "command": "qm stop 100",
      "outcome": "failure"
    },
    {
      "at_seconds": 240,
      "kind": "host_poweroff",
      "outcome": "blocked"
    }
  ]
}
