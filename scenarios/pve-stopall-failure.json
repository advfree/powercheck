{
  "name": "fake PVE stopall failure",
  "description": "pvenode stopall 模拟失败，Guest 保持运行；紧急阶段只记录对剩余 Guest 的强停操作。",
  "duration_seconds": 250,
  "changes": [
    {
      "at_seconds": 0,
      "nut": "OB",
      "lan_reachable": true,
      "wan_reachable": true
    }
  ],
  "fake_pve": {
    "stop_all_result": "failure",
    "guests": [
      {
        "id": 100,
        "name": "app",
        "kind": "vm",
        "shutdown_order": 10
      },
      {
        "id": 300,
        "name": "truenas",
        "kind": "vm",
        "shutdown_order": 100
      }
    ]
  },
  "expected_actions": [
    {
      "at_seconds": 0,
      "kind": "outage_candidate_started"
    },
    {
      "at_seconds": 30,
      "kind": "graceful_shutdown"
    },
    {
      "at_seconds": 240,
      "kind": "emergency_stop_remaining"
    },
    {
      "at_seconds": 240,
      "kind": "host_poweroff_requested"
    }
  ],
  "expected_pve_events": [
    {
      "at_seconds": 30,
      "kind": "pvenode_stopall",
      "outcome": "failure"
    },
    {
      "at_seconds": 240,
      "kind": "guest_emergency_force",
      "guest_id": 100,
      "command": "qm stop 100",
      "outcome": "success"
    },
    {
      "at_seconds": 240,
      "kind": "guest_emergency_force",
      "guest_id": 300,
      "command": "qm stop 300",
      "outcome": "success"
    },
    {
      "at_seconds": 240,
      "kind": "host_poweroff",
      "outcome": "success"
    }
  ]
}
